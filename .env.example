# 局域网家庭影院 · 环境变量示例（复制为 .env 按需覆盖 make / docker-compose）
# 用法：cp .env.example .env  然后填值；make 与 compose 会读取。

# ---------- 镜像与容器 ----------
# REGISTRY=crpi-xxxx.cn-hangzhou.personal.cr.aliyuncs.com
# NAMESPACE=
IMAGE_NAME=family-video
IMAGE_TAG=latest
CONTAINER=family-video

# ---------- 端口 ----------
HOST_PORT=8080
# 微信小程序局域网通道（WSL2 记得放行 Windows 防火墙入站）
LAN_UDP_PORT=9527
LAN_TCP_PORT=9528

# ---------- 片库与数据 ----------
MEDIA_DIR=/mnt/d/迅雷下载
DATA_VOL=fv-data

# ---------- 方案1：HTTPS 播放（备案域名 + DNS-01 证书 + 本地 DNS 指内网） ----------
# FV_DOMAIN：已 ICP 备案、且证书已签发的域名（家里 DNS 应把它解析到本机局域网 IP）
FV_DOMAIN=tv.example.com
# PUBLIC_BASE_URL：下发给小程序的播放基础地址；小程序 <video> 用 https://FV_DOMAIN 出流
PUBLIC_BASE_URL=https://tv.example.com
CADDY_CONTAINER=fv-caddy
CADDY_IMAGE=caddy:2
